<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1000"
             xmlns:vm="using:D8_Demo.ViewModels"
             xmlns:converter="clr-namespace:D8_Demo.Converter"
             x:DataType="vm:M1ReadViewModel"
             x:Class="D8_Demo.Views.UserControl.M1ReadView">
    
    <UserControl.Resources>
        <converter:BoolToRadioConverter x:Key="BoolToRadioConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.block-cell">
            <Setter Property="Background" Value="#6DE5E5E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#A4C0C0C0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.block-cell.selected">
            <Setter Property="Background" Value="#f6ffed" />
            <Setter Property="BorderBrush" Value="#b7eb8f" />
            <Setter Property="Foreground" Value="#52c41a" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.block-cell:pointerover ContentPresenter">
            <Setter Property="Background" Value="#f6ffed" />
            <Setter Property="BorderBrush" Value="#b7eb8f" />
            <Setter Property="Foreground" Value="#52c41a" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="10" RowDefinitions="Auto,*,Auto" RowSpacing="20">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <TextBlock Text="扇区密码:" VerticalAlignment="Center" />
            <ComboBox Width="200" ItemsSource="{Binding PassWorldOptions}"
                      SelectedItem="{Binding PassWorld, Mode=TwoWay}" />
            <Button Command="{Binding ReadCommand}" Theme="{DynamicResource SolidButton}" Classes="Success">读取</Button>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <RadioButton
                    GroupName="PWD"
                    Content="A密码"
                    IsChecked="{Binding PwdType,
                Converter={StaticResource BoolToRadioConverter},
                ConverterParameter=True}" />

                <RadioButton
                    GroupName="PWD"
                    Content="B密码"
                    IsChecked="{Binding PwdType,
                Converter={StaticResource BoolToRadioConverter},
                ConverterParameter=False}" />
            </StackPanel>

        </StackPanel>

        <Grid Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Sectors}" Margin="5">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SectorViewModel">
                        <Grid ColumnDefinitions="0.5*,9.5*" RowSpacing="10" ColumnSpacing="10">
                            <Label Classes="Ghost Blue"
                                   Theme="{DynamicResource TagLabel}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Content="{Binding Title}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Blocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" HorizontalAlignment="Stretch" ColumnSpacing="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BlockCellViewModel">
                                        <Button Classes="block-cell"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding SelectCommand}">
                                            <TextBlock Text="{Binding Data}"
                                                       TextAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <TextBlock Text="块数据：" VerticalAlignment="Center" />
            <TextBox MinWidth="300" Foreground="OrangeRed" Text="{Binding SelectedBlockData}" />
            <TextBlock Text="位置：" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedPosition}" VerticalAlignment="Center" Foreground="Blue" />
            <Button Content="写入" Command="{Binding WriteCommand}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding InputNum,StringFormat='位数：{0}'}" />
        </StackPanel>
    </Grid>
</UserControl>